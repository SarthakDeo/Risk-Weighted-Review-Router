{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://risk-weighted-review-router.onrender.com/$1"
    },
    {
      "src": "/score",
      "dest": "https://risk-weighted-review-router.onrender.com/score"
    },
    {
      "src": "/health",
      "dest": "https://risk-weighted-review-router.onrender.com/health"
    },
    {
      "src": "/webhook",
      "dest": "https://risk-weighted-review-router.onrender.com/webhook"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}