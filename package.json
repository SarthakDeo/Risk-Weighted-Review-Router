{
  "name": "risk-router-person-a",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "risk-map:refresh": "tsx src/risk-map/refresh.ts",
    "db:migrate": "tsx src/db/migrate.ts up",
    "db:rollback": "tsx src/db/migrate.ts down",
    "test": "vitest run --coverage=false"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.12.1",
    "winston": "^3.3.1",
    "yaml": "^2.8.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.5"
  }
}
